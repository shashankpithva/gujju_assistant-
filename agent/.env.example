# Copy to agent/.env and fill in. Never commit .env.

# LiveKit (cloud.livekit.io → your project → Settings → API keys). Needed for `dev`, not `console`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech: Deepgram STT (Nova-3) and TTS (Aura-2). console.deepgram.com → API keys
DEEPGRAM_API_KEY=
# Recognition language: en-US (default), en-IN, or multi (also understands Hindi mixed with English,
# but garbles English names). See docs/agent.md for the comparison on Indian-accented calls.
STT_LANGUAGE=en-US
# The agent's voice: any Deepgram Aura-2 English voice, e.g. aura-2-andromeda-en (default)
TTS_VOICE=aura-2-andromeda-en

# LLM: Groq is primary (fastest first token in week-1 tests), Gemini the alternative. Set LLM_PROVIDER to compare.
# aistudio.google.com → API keys. Check its rate-limit page for the Flash model with the best free quota.
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=groq
GEMINI_MODEL=gemini-3.5-flash-lite
# Lowest thinking level the model accepts: minimal for 3.5 Flash-Lite, low for 3.8 Flash
GEMINI_THINKING_LEVEL=minimal
# Groq models in order; each has its own free per-minute and per-day token budget
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Language of phone and browser calls: en (default, the Deepgram stack) or gu (Gujarati, the Sarvam
# stack below). Text chats stay English. docs/gujarati/README.md has the full guide.
AGENT_LANGUAGE=en

# Sarvam: dashboard.sarvam.ai -> API keys. Every verified account starts with 100 rupees of credit.
SARVAM_API_KEY=

# Hearing. Empty: deepgram for en, sarvam for gu.
#   sarvam           saaras over websocket. Any account. Sends only finished sentences, so any speech
#                    interrupts the agent and "હં" can stop it for a moment.
#   sarvam-realtime  saaras:v3-realtime. Sends partial transcripts, so only real words interrupt,
#                    and it learns dish names. Needs a subscription with realtime access.
#   deepgram         Nova-3 Gujarati. Partial transcripts and keyterms, on your Deepgram credit.
# scripts/gujarati/check_providers.py shows which of these your account can use.
STT_PROVIDER=
SARVAM_STT_MODEL=saaras:v3
# codemix keeps English words in English: "હું office માં છું". transcribe writes everything in Gujarati.
SARVAM_STT_MODE=codemix
# fast, balanced or simulated (sarvam-realtime only)
SARVAM_STT_STREAM_TYPE=balanced
# Sample rate for calls from a phone line; browser calls always use 16000
SARVAM_STT_PHONE_SAMPLE_RATE=8000
# Deepgram's language for a Gujarati call: gu, or multi for mixed speech. STT_LANGUAGE is English-only.
GU_DEEPGRAM_LANGUAGE=gu

# Voice. Empty: deepgram for en, sarvam for gu. Gujarati needs sarvam.
TTS_PROVIDER=
# bulbul:v3, or bulbul:v4-flash (a third of the price, with Gujarati voices of its own)
SARVAM_TTS_MODEL=bulbul:v3
# PROVISIONAL: nobody has listened yet. Choose with scripts/gujarati/voice_audition.py. The grammar
# follows this voice (સમજી ગયો or સમજી ગઈ). v4-flash voices: bhavik_gu_conversation,
# pooja_gu_conversational, pooja_gu_customer
SARVAM_TTS_SPEAKER=shubh
# Only for a voice that isn't listed in languages.py: male or female
SARVAM_TTS_GENDER=
# 1.0 is normal. Try 0.9 to 1.1 in the audition; older callers may want it slower.
SARVAM_TTS_PACE=1.0
# How expressive, from 0.01 to 1.0 (bulbul:v3 only; v4-flash ignores it)
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_SAMPLE_RATE=24000
# mp3 is the plugin's own default. linear16 skips decoding, and may start sooner: measure it.
SARVAM_TTS_CODEC=mp3
# A Sarvam pronunciation dictionary, if you make one (bulbul:v3 and v4-flash)
SARVAM_TTS_DICT_ID=

# LiveKit's turn detector doesn't list Gujarati. on: it runs with Hindi's threshold. off: silence only.
GU_TURN_DETECTOR=on

# Restaurant data. sample (default): a built-in fictional restaurant; bookings are saved in
# agent/.sample_state.json (delete it to reset). api: the web tool API at API_BASE_URL.
DATA_SOURCE=sample
# Restaurant used when the call doesn't say which one (console mode, browser tests)
DEFAULT_RESTAURANT_PHONE=+14155550123

# Call limits that protect the free tiers: longest call, and seconds of silence before
# "Are you still there?" (and again before hanging up)
MAX_CALL_SECONDS=300
SILENCE_CHECK_IN_SECONDS=10

# Text chats (uv run python -m agent.chat telegram): the bot token from @BotFather, and the Telegram
# user IDs allowed to use it, comma-separated (@userinfobot shows yours). Anyone else is turned away.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# The restaurant the bot answers for, by its number in the API. Empty: DEFAULT_RESTAURANT_PHONE
TELEGRAM_RESTAURANT_PHONE=
# Seconds to wait for more messages before replying (a burst gets one reply), and minutes of quiet
# that end a chat (it's then logged; the next message starts a new one)
CHAT_QUIET_SECONDS=1.5
CHAT_IDLE_MINUTES=30

# Telegram calls, for testing (uv run --group telegram-call python -m agent.telegram_call): a Telegram
# *user* account answers calls from TELEGRAM_ALLOWED_USER_IDS with the voice agent. The id and hash
# come from my.telegram.org (API development tools). The login is kept in
# TELEGRAM_CALL_SESSION.session, which is the account's login: never share or commit it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CALL_SESSION=.telegram_call

# Tool API (web/), used when DATA_SOURCE=api: http://localhost:3000 for the web app run locally
# (cd web && pnpm dev), or http://127.0.0.1:4010 for the Prism mock of contracts/openapi.yaml
API_BASE_URL=http://localhost:3000
# Shared secret sent as the x-agent-key header. Must match AGENT_API_KEY in web/.env.local
AGENT_API_KEY=
