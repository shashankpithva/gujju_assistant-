# Copy to agent/.env and fill in. Never commit .env. docs/agent.md explains each step.

# --- LiveKit: runs the calls (cloud.livekit.io -> your project -> Settings -> API keys) -------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The name calls are sent to. The agent and the dialer read the same .env, so they match.
AGENT_NAME=gujju-survey

# --- The phone line: a LiveKit outbound SIP trunk (lk sip outbound create, see docs/agent.md) ------
# Its id, ST_...
SIP_OUTBOUND_TRUNK_ID=
# The caller ID to show, if the trunk has more than one number. Empty: the trunk's own.
SIP_FROM_NUMBER=
# Numbers in the sheet with no country code are in this country (91: India)
DEFAULT_COUNTRY_CODE=91
# Seconds to let the phone ring before giving up (counted as no_answer)
RING_SECONDS=35

# --- The sheet: numbers in, answers out ------------------------------------------------------------
# A Google Sheet: its id or its whole address. Share the sheet with the service account's email
# (client_email in the key file) as an Editor.
GOOGLE_SHEET_ID=
# The tab to use. Empty: the first one.
GOOGLE_SHEET_TAB=
# The service account key: a path to the .json file, or (for LiveKit Cloud secrets) the file's
# contents or their base64 in GOOGLE_SERVICE_ACCOUNT_JSON. Never commit the key.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or, without Google, a CSV file on this computer (used when GOOGLE_SHEET_ID is empty). Only works
# with the agent running on this computer too (agent.main dev), not deployed to LiveKit Cloud.
SURVEY_CSV=contacts.csv
# Times in the sheet's "Last call" column, and for the calling hours below
SURVEY_TIMEZONE=Asia/Kolkata
# The dialer only places calls in these hours (9 AM to 9 PM). `--any-time` overrides it for a test call.
SURVEY_CALL_HOURS=9-21

# --- What the agent says ---------------------------------------------------------------------------
# Who the call is from, as people would know it, e.g. ગ્રામ પંચાયત. Empty: "I'm an AI assistant".
SURVEY_ORG_NAME=
# The answer to "why are you asking?". Empty: a sentence about collecting water-supply information.
SURVEY_PURPOSE=
# on: a village, taluka or district goes in the sheet only if it's in the list of Gujarat's places
# (src/agent/places) and the person says yes when it's read back. off: any name, still read back.
PLACE_CHECK=on

# --- Hearing and speaking Gujarati: Sarvam (dashboard.sarvam.ai -> API keys) ------------------------
SARVAM_API_KEY=
# Hearing. Empty: sarvam.
#   sarvam           saaras over websocket. Any account. Sends only finished sentences.
#   sarvam-realtime  saaras:v3-realtime. Sends partial transcripts; needs realtime access.
#   deepgram         Nova-3 Gujarati, on DEEPGRAM_API_KEY.
# scripts/check_providers.py shows which of these your account can use.
STT_PROVIDER=
SARVAM_STT_MODEL=saaras:v3
# codemix keeps English words in English: "પાણી daily આવે છે"
SARVAM_STT_MODE=codemix
# on: ask Sarvam for the words the moment a turn ends instead of waiting for its own end-of-speech
# detection. Faster after short answers like a name; try it on a test call before a demo.
SARVAM_STT_FLUSH=off
SARVAM_STT_STREAM_TYPE=balanced
SARVAM_STT_PHONE_SAMPLE_RATE=8000
DEEPGRAM_API_KEY=
GU_DEEPGRAM_LANGUAGE=gu
# The voice: bulbul:v3, or bulbul:v4-flash (Gujarati voices bhavik_gu_conversation, pooja_gu_conversational)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# Only for a voice not listed in languages.py: male or female
SARVAM_TTS_GENDER=
# 1.0 is normal. Older people may prefer 0.9.
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_CODEC=mp3
SARVAM_TTS_DICT_ID=

# --- The LLM: reads each answer (one short request per turn) ---------------------------------------
# console.groq.com and aistudio.google.com. One is enough; with both, a rate limit on one moves to the
# other. Free tiers may train on what you send: test with your own number, not real people's.
GROQ_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=groq
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# --- Turn-taking and limits -------------------------------------------------------------------------
# LiveKit's turn detector (on), or silence alone (off)
GU_TURN_DETECTOR=on
# Seconds of silence after an answer before it counts as finished, and the most to wait when the
# turn detector thinks the person is mid-thought
ENDPOINTING_MIN_DELAY=0.7
ENDPOINTING_MAX_DELAY=2.0
# Speech that brought no words: ask again after this many seconds (the fix for short answers lost)
TRANSCRIPTION_TIMEOUT_SECONDS=3
# Seconds of silence before "હેલો, તમને મારો અવાજ સંભળાય છે?", and again before hanging up
SILENCE_CHECK_IN_SECONDS=8
# Longest call, in seconds
MAX_CALL_SECONDS=240
# Seconds to wait for the person's "હેલો?" after they pick up, before the introduction
HELLO_WAIT_SECONDS=2
# off: no LiveKit noise cancellation (for troubleshooting)
NOISE_CANCELLATION=on
